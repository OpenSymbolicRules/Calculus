{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "2.3",
  "title": "Structural Derivative Rule Tests",
  "tests": [
    {
      "id": 1,
      "expression": ["Derivative", ["Lambda", "x", ["Add", ["Sin", "x"], ["Exp", "x"]]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Add", ["Derivative", ["Lambda", "x", ["Sin", "x"]]], ["Derivative", ["Lambda", "x", ["Exp", "x"]]]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 2,
      "expression": ["Derivative", ["Lambda", "x", ["Multiply", ["Sin", "x"], ["Exp", "x"]]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Add", ["Multiply", ["Sin", "x"], ["Derivative", ["Lambda", "x", ["Exp", "x"]]]], ["Multiply", ["Derivative", ["Lambda", "x", ["Sin", "x"]]], ["Exp", "x"]]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 3,
      "expression": ["Derivative", ["Lambda", "x", ["Subtract", ["Exp", "x"], ["Sin", "x"]]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Subtract", ["Derivative", ["Lambda", "x", ["Exp", "x"]]], ["Derivative", ["Lambda", "x", ["Sin", "x"]]]]],
      "num_steps": 1,
      "grade": "A"
    }
  ]
}
