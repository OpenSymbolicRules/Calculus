{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "2.2",
  "title": "Elementary Derivative Rules Tests",
  "tests": [
    {
      "id": 1,
      "expression": ["Derivative", ["Lambda", "x", "x"]],
      "variable": "x",
      "expected_result": ["Lambda", "x", 1],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 2,
      "expression": ["Derivative", ["Lambda", "x", ["Sin", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Cos", "x"]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 3,
      "expression": ["Derivative", ["Lambda", "x", ["Exp", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Exp", "x"]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 4,
      "expression": ["Derivative", ["Lambda", "x", ["Tan", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Divide", 1, ["Power", ["Cos", "x"], 2]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 5,
      "expression": ["Derivative", ["Lambda", "x", ["Sinh", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Cosh", "x"]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 6,
      "expression": ["Derivative", ["Lambda", "x", ["Cosh", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Sinh", "x"]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 7,
      "expression": ["Derivative", ["Lambda", "x", ["Tanh", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Divide", 1, ["Power", ["Cosh", "x"], 2]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 8,
      "expression": ["Derivative", ["Lambda", "x", ["Atan", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Divide", 1, ["Add", 1, ["Power", "x", 2]]]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 9,
      "expression": ["Derivative", ["Lambda", "x", ["Atanh", "x"]]],
      "variable": "x",
      "expected_result": ["Lambda", "x", ["Divide", 1, ["Subtract", 1, ["Power", "x", 2]]]],
      "num_steps": 1,
      "grade": "A"
    }
  ]
}
