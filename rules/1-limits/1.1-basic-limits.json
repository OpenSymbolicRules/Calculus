{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.1",
  "title": "Basic Limits",
  "semantics": {
    "Limit": "openmath:limit1#limit",
    "BothSides": "openmath:limit1#both_sides",
    "Lambda": "openmath:fns1#lambda",
    "Sin": "openmath:transc1#sin",
    "Cos": "openmath:transc1#cos",
    "Tan": "openmath:transc1#tan",
    "Exp": "openmath:transc1#exp",
    "Log": "openmath:transc1#ln",
    "Add": "openmath:arith1#plus",
    "Subtract": "openmath:arith1#minus",
    "Power": "openmath:arith1#power",
    "Divide": "openmath:arith1#divide"
  },
  "rules": [
    {
      "id": 1,
      "description": "Limit of a constant: lim_{x->a} c = c",
      "pattern": [
        "Limit",
        "a_",
        "BothSides",
        [
          "Lambda",
          "x_",
          "c_"
        ]
      ],
      "constraints": [
        [
          "FreeQ",
          "c_",
          "x_"
        ]
      ],
      "result": "c_",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Calculus",
            "locator": "calculus:1-limits/1.1-basic-limits:1"
          }
        ]
      }
    },
    {
      "id": 2,
      "description": "Fundamental sine limit: lim_{x->0} sin(x)/x = 1",
      "pattern": [
        "Limit",
        0,
        "BothSides",
        [
          "Lambda",
          "x_",
          [
            "Divide",
            [
              "Sin",
              "x_"
            ],
            "x_"
          ]
        ]
      ],
      "constraints": [],
      "result": 1,
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Calculus",
            "locator": "calculus:1-limits/1.1-basic-limits:2"
          }
        ]
      }
    },
    {
      "id": 3,
      "description": "Fundamental tangent limit: lim(x→0) tan(x)/x = 1.",
      "pattern": [
        "Limit",
        0,
        "BothSides",
        [
          "Lambda",
          "x_",
          [
            "Divide",
            [
              "Tan",
              "x_"
            ],
            "x_"
          ]
        ]
      ],
      "constraints": [],
      "result": 1,
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Calculus",
            "locator": "calculus:1-limits/1.1-basic-limits:3"
          }
        ]
      }
    },
    {
      "id": 4,
      "description": "Second-order cosine limit: lim(x→0) (1 - cos(x))/x² = 1/2.",
      "pattern": [
        "Limit",
        0,
        "BothSides",
        [
          "Lambda",
          "x_",
          [
            "Divide",
            [
              "Subtract",
              1,
              [
                "Cos",
                "x_"
              ]
            ],
            [
              "Power",
              "x_",
              2
            ]
          ]
        ]
      ],
      "constraints": [],
      "result": [
        "Divide",
        1,
        2
      ],
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Calculus",
            "locator": "calculus:1-limits/1.1-basic-limits:4"
          }
        ]
      }
    },
    {
      "id": 5,
      "description": "Fundamental exponential limit: lim(x→0) (exp(x) - 1)/x = 1.",
      "pattern": ["Limit", 0, "BothSides", ["Lambda", "x_", ["Divide", ["Subtract", ["Exp", "x_"], 1], "x_"]]],
      "constraints": [],
      "result": 1,
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Calculus",
            "locator": "calculus:1-limits/1.1-basic-limits:5"
          }
        ]
      }
    },
    {
      "id": 6,
      "description": "Fundamental logarithmic limit: lim(x→0) log(1 + x)/x = 1.",
      "pattern": ["Limit", 0, "BothSides", ["Lambda", "x_", ["Divide", ["Log", ["Add", 1, "x_"]], "x_"]]],
      "constraints": [],
      "result": 1,
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Calculus",
            "locator": "calculus:1-limits/1.1-basic-limits:6"
          }
        ]
      }
    }
  ],
  "identity": "calculus:1-limits/1.1-basic-limits"
}
